{
  "name": "frontend-study",
  "version": "0.4.1",
  "private": true,
  "description": "AI Frontend Engineering Lab",
  "author": "liuxinyu",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:cov": "turbo test:cov",
    "test:e2e": "pnpm --filter @frontend-study/web test:e2e",
    "knip": "knip",
    "clean": "turbo clean",
    "check:structure": "pnpm --filter @frontend-study/web check:structure",
    "check": "pnpm check:structure && pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm knip",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @frontend-study/web lint:fix"
    ],
    "apps/server/**/*.{ts,js}": [
      "pnpm --filter @frontend-study/server lint:fix"
    ],
    "packages/shared-types/**/*.ts": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.6",
    "typescript": "~6.0.3"
  }
}

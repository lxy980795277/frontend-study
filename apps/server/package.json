{
  "name": "@frontend-study/server",
  "version": "0.0.0",
  "private": true,
  "description": "AI Frontend Engineering Lab Server",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate --config prisma/prisma.config.ts && nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "prisma generate --config prisma/prisma.config.ts && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prisma:generate": "prisma generate --config prisma/prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma/prisma.config.ts",
    "clean": "rm -rf dist coverage src/generated"
  },
  "dependencies": {
    "@frontend-study/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-mariadb": "7.9.0",
    "@prisma/client": "7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@frontend-study/eslint-config": "workspace:*",
    "@frontend-study/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "prisma": "7.9.1",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}

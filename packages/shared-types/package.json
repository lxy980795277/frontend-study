{
  "name": "@frontend-study/shared-types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@frontend-study/eslint-config": "workspace:*",
    "@frontend-study/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.57"
  }
}
